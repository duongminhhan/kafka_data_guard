KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONNECT_URL=http://localhost:8083
KAFKA_REQUEST_TOPIC=KDG_REQUEST
KAFKA_CONSUMER_GROUP=APP_CDC_KDG
KAFKA_TRANSACTIONAL_ID=debezium-oracle-remediation-v1
KAFKA_TRANSACTION_TIMEOUT_MS=60000
KAFKA_TRANSACTION_API_TIMEOUT_SECONDS=30
KAFKA_PUBLISH_FLUSH_TIMEOUT_SECONDS=30
KAFKA_CLOSE_FLUSH_TIMEOUT_SECONDS=10
KAFKA_MAX_POLL_INTERVAL_MS=3600000
KAFKA_CONSUMER_POLL_TIMEOUT_SECONDS=0.5
KAFKA_RETRY_DELAY_SECONDS=5
KAFKA_CONSUMER_STOP_TIMEOUT_SECONDS=15
KAFKA_CONNECT_HTTP_TIMEOUT_SECONDS=10
KAFKA_CONNECT_CONFIG_CACHE_TTL_SECONDS=60

CONFIG_DB_HOST=localhost
CONFIG_DB_PORT=14330
CONFIG_DB_NAME=ingest_reference
CONFIG_DB_USER=kafka_guard_app
CONFIG_DB_PASSWORD=change-me
CONFIG_CACHE_TTL_SECONDS=300
CONFIG_DB_LOGIN_TIMEOUT_SECONDS=10
CONFIG_DB_QUERY_TIMEOUT_SECONDS=15
ORACLE_LOCALHOST_ALIAS=
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=1
ESCALATION_HTTP_TIMEOUT_SECONDS=10
REQUEST_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOG_LEVEL=INFO

# Generic JSON webhook for an existing Slack/PagerDuty relay. Blank means log only.
ESCALATION_WEBHOOK_URL=

# SQL Server configuration store for Kafka Guard.
MSSQL_SA_PASSWORD=change-me-with-a-strong-password
MSSQL_PORT=14330
MSSQL_PID=Developer
